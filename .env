VITE_APP_VERSION = v1.4.1

#Project Specific Properties
VITE_QCHAT_ENCRYPTION_ID=<sorry-mahn-cant-give-this>

# Domains are NOT set here - they live in:
#   .env.development  -> local   (vite dev server, start_server.bat local)
#   .env.production   -> live    (npm run build, start_server.bat prod)

VITE_CHAT_USER_AUTH=chat/users/auth/
VITE_CHAT_CONVERSATION=chat/conv/{recipient_username}/
VITE_CHAT_RECIPIENTS=chat/conv/recipients/

VITE_QUICK_CHAT_CONVERSATIONS=qchat/conversations/

VITE_ANONYMOUS=anonymous/
# Textbox is WebSocket-only (ws/textbox/, derived from VITE_API_BASE_URL; override with VITE_TEXTBOX_WS_URL).

VITE_ADMIN_AUTH=admin/auth/
VITE_TEXTBOX_LIST=textbox/list/